namespace Magpie {
	enum ShortcutAction {
		Scale,
		WindowedModeScale,
		Toolbar,
		Profiler,
		EffectParameters,
		Screenshot,
		ToolbarPin,
		Comparison,
		COUNT_OR_NONE
	};

	runtimeclass ShortcutControl : Windows.UI.Xaml.Controls.Grid, Windows.UI.Xaml.Data.INotifyPropertyChanged {
		ShortcutControl();

		ShortcutAction Action;
		String Title;
	}
}
